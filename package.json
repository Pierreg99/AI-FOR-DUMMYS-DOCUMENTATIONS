{
  "name": "ai-for-everyone-learn-docs",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "A bilingual, accessible field guide to AI systems.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run build && npm test",
    "format": "prettier --write \"assets/*.{js,css}\" \"scripts/*.mjs\" \"tests/**/*.mjs\" \"data/*.json\" index.html package.json playwright.config.mjs",
    "format:check": "prettier --check \"assets/*.{js,css}\" \"scripts/*.mjs\" \"tests/**/*.mjs\" \"data/*.json\" index.html package.json playwright.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "marked": "18.0.14",
    "prettier": "3.6.2"
  }
}
